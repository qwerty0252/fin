# Environment Variables — BankOps Integration Hub
# Copy this file to .env and fill in real values. Never commit .env.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=true

# ─── API Gateway ──────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8000
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# ─── Transaction Service ──────────────────────────────────────────────────────
TRANSACTION_SERVICE_PORT=8001
TRANSACTION_SERVICE_URL=http://transaction-service:8001

# ─── Event Bus Service ────────────────────────────────────────────────────────
EVENT_BUS_PORT=8002

# ─── Orchestration Engine ─────────────────────────────────────────────────────
ORCHESTRATION_ENGINE_PORT=8003
ORCHESTRATION_SERVICE_URL=http://orchestration-engine:8003

# ─── Connector Framework ──────────────────────────────────────────────────────
CONNECTOR_FRAMEWORK_PORT=8004
CONNECTOR_SERVICE_URL=http://connector-framework:8004

# ─── Notification Service ─────────────────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=8005

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bankops
POSTGRES_USER=bankops
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://bankops:change-me-postgres-password@postgres:5432/bankops

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=bankops
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=bankops
RABBITMQ_URL=amqp://bankops:change-me-rabbitmq-password@rabbitmq:5672/bankops

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=bankops-api-hub
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ─── Notifications ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERTS_EMAIL=ops@yourorg.com

# ─── Connector — Mock Payment Switch ──────────────────────────────────────────
MOCK_SWITCH_ENABLED=true
MOCK_SWITCH_FAILURE_RATE=0.05      # 5% simulated failure rate

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20
